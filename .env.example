# Public URL of the app (optional locally; set to your Vercel domain in production)
APP_URL=http://localhost:3000

# Google Gemini API key — required for mockup and product-edit generation
GEMINI_API_KEY=

# Neon Postgres connection string — persists usage_events (runs + feedback); see README "Database (Neon)"
DATABASE_URL=

# ImgBB API key — uploads input/output images; only URLs are stored in Postgres (https://api.imgbb.com/)
IMGBB_API_KEY=
