{
  "name": "mockuper",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun tailwindcss -i ./src/tailwind.css -o ./src/app.css && bun run --parallel dev:server dev:css",
    "dev:server": "bun --hot server.ts",
    "dev:css": "bun tailwindcss -i ./src/tailwind.css -o ./src/app.css --watch=always",
    "build": "bun tailwindcss -i ./src/tailwind.css -o ./src/app.css --minify && bun build ./index.html --outdir=dist --minify",
    "start": "NODE_ENV=production bun server.ts",
    "clean": "rm -rf dist",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "check": "biome check . && tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@tailwindcss/cli": "^4.3.0",
    "bun-types": "latest",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2"
  }
}
